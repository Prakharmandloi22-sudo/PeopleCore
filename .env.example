# ==============================================================================
# PeopleCore HRMS Platform - Environment Variables Template
# Copy this file to .env in backend, python-services, and frontend as appropriate.
# NEVER commit raw secrets or production credentials to source control.
# ==============================================================================

# System Environment
NODE_ENV=development
APP_PORT=5000
FRONTEND_PORT=3000
PYTHON_SERVICE_PORT=8000

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/peoplecore?schema=public
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=peoplecore

# Redis & BullMQ Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Authentication
JWT_ACCESS_SECRET=peoplecore_super_secure_access_secret_change_in_production_key_2026
JWT_REFRESH_SECRET=peoplecore_super_secure_refresh_secret_change_in_production_key_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_SALT_ROUNDS=10

# Python FastAPI Microservice Bridge
PYTHON_SERVICE_URL=http://localhost:8000
PYTHON_API_KEY=peoplecore_internal_python_service_secret_token_2026

# Email / SMTP Mock Settings
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASS=mock_pass
EMAIL_FROM=PeopleCore Notifications <notifications@peoplecore.local>

# Storage & Document Vault
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_MAX_FILE_SIZE_MB=15

# Mock Banking & Payroll Exports
BANK_EXPORT_ROUTING_NUMBER=123456789
BANK_EXPORT_COMPANY_ID=PEOPLECORE_HRMS
COMPANY_LEGAL_NAME=PeopleCore Enterprise Global Inc.
