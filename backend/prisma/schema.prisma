datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMINISTRATOR
  HR_OFFICER
  MANAGER
  PAYROLL_SPECIALIST
  EMPLOYEE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  INTERN
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ComponentType {
  EARNING
  DEDUCTION
  BENEFIT
}

enum CalculationType {
  FIXED
  PERCENTAGE_OF_BASE
  FORMULA
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  APPROVED
  FINALIZED
  PAID
}

enum PayslipStatus {
  PENDING
  PAID
  FAILED
}

enum DocumentCategory {
  ID_PROOF
  CONTRACT
  TAX_FORM
  PAYSLIP
  CERTIFICATE
  MEDICAL
}

enum DocumentAccessLevel {
  CONFIDENTIAL
  RESTRICTED
  PUBLIC
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(EMPLOYEE)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee Employee?
  auditLogs AuditLog[]

  @@index([email])
  @@index([role])
}

model Department {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  managerId   String?  // Reference to Employee ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees    Employee[]
  designations Designation[]

  @@index([code])
}

model Designation {
  id           String     @id @default(uuid())
  title        String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  minSalary    Decimal    @default(0.00) @db.Decimal(12, 2)
  maxSalary    Decimal    @default(0.00) @db.Decimal(12, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  employees Employee[]

  @@index([departmentId])
}

model Employee {
  id                     String           @id @default(uuid())
  employeeNumber         String           @unique
  userId                 String           @unique
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName              String
  lastName               String
  dateOfBirth            DateTime
  gender                 String
  phone                  String
  address                String?
  emergencyContact       String?
  departmentId           String
  department             Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  designationId          String
  designation            Designation      @relation(fields: [designationId], references: [id], onDelete: Restrict)
  managerId              String?
  manager                Employee?        @relation("EmployeeHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  directReports          Employee[]       @relation("EmployeeHierarchy")
  employmentType         EmploymentType   @default(FULL_TIME)
  employmentStatus       EmploymentStatus @default(ACTIVE)
  hireDate               DateTime
  probationEndDate       DateTime?
  terminationDate        DateTime?
  
  // Sensitive financial attributes (Protected by RBAC field masking)
  baseSalary             Decimal          @db.Decimal(12, 2)
  currency               String           @default("USD")
  bankName               String?
  bankAccountNumber      String?          // Masked in presentation: ****1234
  bankRoutingNumber      String?

  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  shifts                 EmployeeShift[]
  attendanceRecords      AttendanceRecord[]
  leaveBalances          LeaveBalance[]
  leaveRequests          LeaveRequest[]
  salaryComponents       EmployeeSalaryComponent[]
  payslips               Payslip[]
  reviewsAsEmployee      PerformanceReview[] @relation("EmployeeReviews")
  reviewsAsReviewer      PerformanceReview[] @relation("ReviewerReviews")
  documents              Document[]

  @@index([employeeNumber])
  @@index([departmentId])
  @@index([managerId])
  @@index([employmentStatus])
}

model Shift {
  id                 String          @id @default(uuid())
  code               String          @unique
  name               String
  startTime          String          // "09:00" or "22:00"
  endTime            String          // "17:00" or "06:00"
  isOvernight        Boolean         @default(false)
  gracePeriodMinutes Int             @default(15)
  workHoursPerDay    Decimal         @default(8.00) @db.Decimal(4, 2)
  colorCode          String          @default("#3B82F6")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  employeeShifts     EmployeeShift[]
  attendanceRecords  AttendanceRecord[]

  @@index([code])
}

model EmployeeShift {
  id            String    @id @default(uuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId       String
  shift         Shift     @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([employeeId, effectiveFrom])
}

model AttendanceRecord {
  id                 String             @id @default(uuid())
  employeeId         String
  employee           Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shiftId            String?
  shift              Shift?             @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  date               DateTime           @db.Date
  checkInTime        DateTime?
  checkOutTime       DateTime?
  totalWorkHours     Decimal            @default(0.00) @db.Decimal(5, 2)
  regularHours       Decimal            @default(0.00) @db.Decimal(5, 2)
  overtimeHours      Decimal            @default(0.00) @db.Decimal(5, 2)
  status             AttendanceStatus   @default(PRESENT)
  verificationMethod String             @default("WEB_PORTAL") // BIOMETRIC, WEB_PORTAL, MOBILE_GPS
  notes              String?
  isCorrected        Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  corrections        AttendanceCorrection[]

  @@unique([employeeId, date])
  @@index([employeeId, date])
  @@index([status])
}

model AttendanceCorrection {
  id                 String           @id @default(uuid())
  attendanceRecordId String
  attendanceRecord   AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  requestedBy        String           // User ID
  correctedCheckIn   DateTime
  correctedCheckOut  DateTime
  reason             String
  status             CorrectionStatus @default(PENDING)
  approvedBy         String?          // User ID
  reviewedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([attendanceRecordId])
  @@index([status])
}

model LeaveType {
  id                 String         @id @default(uuid())
  code               String         @unique
  name               String
  description        String?
  annualAllowance    Decimal        @db.Decimal(5, 2)
  isPaid             Boolean        @default(true)
  requiresProof      Boolean        @default(false)
  allowsCarryover    Boolean        @default(false)
  maxCarryoverDays   Decimal        @default(0.00) @db.Decimal(5, 2)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]

  @@index([code])
}

model LeaveBalance {
  id               String    @id @default(uuid())
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId      String
  leaveType        LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year             Int
  allocatedDays    Decimal   @default(0.00) @db.Decimal(5, 2)
  usedDays         Decimal   @default(0.00) @db.Decimal(5, 2)
  pendingDays      Decimal   @default(0.00) @db.Decimal(5, 2)
  carriedOverDays  Decimal   @default(0.00) @db.Decimal(5, 2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId, year])
}

model LeaveRequest {
  id              String      @id @default(uuid())
  employeeId      String
  employee        Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId     String
  leaveType       LeaveType   @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  totalDays       Decimal     @db.Decimal(4, 2)
  isHalfDay       Boolean     @default(false)
  reason          String
  status          LeaveStatus @default(PENDING)
  approvedBy      String?     // User ID or Manager Employee ID
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([employeeId, status])
  @@index([startDate, endDate])
}

model SalaryComponent {
  id              String          @id @default(uuid())
  code            String          @unique
  name            String
  type            ComponentType
  calculationType CalculationType @default(FIXED)
  isTaxable       Boolean         @default(true)
  isStatutory     Boolean         @default(false)
  defaultValue    Decimal         @default(0.00) @db.Decimal(12, 2)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  employeeComponents EmployeeSalaryComponent[]

  @@index([code])
}

model EmployeeSalaryComponent {
  id           String          @id @default(uuid())
  employeeId   String
  employee     Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  componentId  String
  component    SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  amount       Decimal         @default(0.00) @db.Decimal(12, 2)
  percentage   Decimal?        @db.Decimal(5, 2)
  isOverridden Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([employeeId, componentId])
  @@index([employeeId])
}

model PayrollPeriod {
  id                          String        @id @default(uuid())
  periodCode                  String        @unique // e.g. "2026-03-MONTHLY"
  name                        String        // e.g. "March 2026 Regular Payroll"
  startDate                   DateTime      @db.Date
  endDate                     DateTime      @db.Date
  payDate                     DateTime      @db.Date
  status                      PayrollStatus @default(DRAFT)
  totalGrossPay               Decimal       @default(0.00) @db.Decimal(14, 2)
  totalNetPay                 Decimal       @default(0.00) @db.Decimal(14, 2)
  totalDeductions             Decimal       @default(0.00) @db.Decimal(14, 2)
  totalEmployerContributions  Decimal       @default(0.00) @db.Decimal(14, 2)
  processedBy                 String?       // User ID
  finalizedAt                 DateTime?
  finalizedBy                 String?       // User ID
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt

  payslips                    Payslip[]

  @@index([periodCode])
  @@index([status])
}

model Payslip {
  id              String        @id @default(uuid())
  payrollPeriodId String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payslipNumber   String        @unique // e.g. "PS-2026-03-0001"
  baseSalary      Decimal       @db.Decimal(12, 2)
  grossPay        Decimal       @db.Decimal(12, 2)
  totalDeductions Decimal       @db.Decimal(12, 2)
  netPay          Decimal       @db.Decimal(12, 2)
  paymentStatus   PayslipStatus @default(PENDING)
  bankReference   String?
  generatedAt     DateTime      @default(now())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           PayslipItem[]

  // Domain Challenge Enforcer: Unique constraint guarantees idempotency per employee per period!
  @@unique([payrollPeriodId, employeeId])
  @@index([employeeId])
  @@index([payrollPeriodId])
  @@index([payslipNumber])
}

model PayslipItem {
  id            String        @id @default(uuid())
  payslipId     String
  payslip       Payslip       @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  componentCode String
  componentName String
  componentType ComponentType
  amount        Decimal       @db.Decimal(12, 2)
  isDeduction   Boolean       @default(false)
  createdAt     DateTime      @default(now())

  @@index([payslipId])
}

model PerformanceReview {
  id                   String   @id @default(uuid())
  employeeId           String
  employee             Employee @relation("EmployeeReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId           String
  reviewer             Employee @relation("ReviewerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewPeriod         String   // e.g. "2025-Annual" or "2026-Q1"
  reviewDate           DateTime @db.Date
  overallRating        Int      // 1 to 5
  strengths            String?  @db.Text
  areasForImprovement  String?  @db.Text
  goals                String?  @db.Text
  status               String   @default("SUBMITTED") // DRAFT, SUBMITTED, COMPLETED
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([employeeId])
  @@index([reviewerId])
}

model Document {
  id             String              @id @default(uuid())
  employeeId     String
  employee       Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title          String
  category       DocumentCategory    @default(ID_PROOF)
  fileUrl        String
  fileKey        String              @unique
  fileSize       Int                 // bytes
  mimeType       String
  checksum       String              // SHA-256 integrity hash
  uploadedBy     String              // User ID
  accessLevel    DocumentAccessLevel @default(CONFIDENTIAL)
  isVirusScanned Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([employeeId])
  @@index([category])
  @@index([accessLevel])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  actorRole  Role
  action     String   // e.g. "SALARY_VIEW", "PAYROLL_RUN", "LEAVE_APPROVAL", "EMPLOYEE_UPDATE"
  entityName String   // e.g. "Employee", "PayrollPeriod", "LeaveRequest"
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@index([actorId])
  @@index([entityName, entityId])
  @@index([action])
  @@index([timestamp])
}
